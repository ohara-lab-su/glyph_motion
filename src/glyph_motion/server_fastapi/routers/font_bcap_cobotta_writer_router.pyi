from typing import Optional, Any, Dict, overload
from glyph_motion.server_fastapi.models.writer import MotionParametersRequest, OriginParametersRequest, PreviewTextRequest, SetConfigRequest, TextParametersRequest, TransformParametersRequest, WriteTextRequest
from fastapi import APIRouter
class FontBcapCobottaWriterRouter:
    """
    FastAPI Router動的生成用ベースクラス
    api_specの内容に応じて動的にhandler/routeを生やす
    """

    def __init__(self, device_instance, api_spec, logger: Optional[Any] = None, log_level: str = 'INFO'): ...
    @staticmethod
    def _model_field_names(model_cls) -> list[str]: ...
    def _extract_args_kwargs(self, api, request, target_func=None): ...
    def _resolve_callable_api(self, api, request): ...
    @staticmethod
    def _wrap_response(result, api) -> Any: ...
    def _make_handler(self, api): ...
    async def _dispatch_handler(self, request: dict): ...
    _logger: Any
    router: APIRouter
    # b-CAP に接続する
    async def connect(self) -> Any: ...
    # TakeArm、MotorOn、加減速設定、開始姿勢準備を行う
    async def prepare(self) -> Any: ...
    # b-CAP 接続を閉じる
    async def disconnect(self) -> Any: ...
    # 終了処理を行う
    async def close(self) -> Any: ...
    # ロボット動作を停止する
    async def halt(self) -> Any: ...
    # COBOTTA エラーをリセットする
    async def reset_error(self) -> Any: ...
    # 接続状態を返す
    async def is_connected(self) -> Any: ...
    # 現在 P 座標を取得する
    async def get_current_position(self) -> Any: ...
    # 現在設定を返す
    async def get_config(self) -> Any: ...
    # 設定値をまとめて更新する
    async def set_config(self, request: Optional[SetConfigRequest | Dict] = None) -> Any: ...
    # 文字生成条件を更新する
    async def set_text_parameters(self, request: Optional[TextParametersRequest | Optional | Optional | Optional | Optional | Optional] = None) -> Any: ...
    # 速度・加減速・投入間隔を更新する
    async def set_motion_parameters(self, request: Optional[MotionParametersRequest | Optional | Optional | Optional | Optional | Optional | Optional | Optional | Optional | Optional | Optional] = None) -> Any: ...
    # 書字原点と書字面 Z を更新する
    async def set_origin_parameters(self, request: Optional[OriginParametersRequest | Optional | Optional | Optional | Optional | Optional | Optional] = None) -> Any: ...
    # ロボット座標写像を更新する
    async def set_transform_parameters(self, request: Optional[TransformParametersRequest | Optional | Optional | Optional | Optional | Optional | Optional | Optional | Optional | Optional] = None) -> Any: ...
    # ロボットへ投入せず命令概要を返す
    async def preview_text(self, request: Optional[PreviewTextRequest | str | Optional | int] = None) -> Any: ...
    # 任意文字列を書く
    async def write_text(self, request: Optional[WriteTextRequest | str | Optional | bool] = None) -> Any: ...